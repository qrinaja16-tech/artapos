# ==========================================
# KONFIGURASI BOT PENJUALAN WHATSAPP
# ==========================================

# Nama Bot / Toko
BOT_NAME=Toko AI Assistant

# Prefix Perintah (default titik: .menu, .tambah, .list)
PREFIX=.

# Centang Biru Otomatis saat pesan masuk (true / false)
AUTO_READ=true

# Di dalam Grup: hanya respon jika bot di-tag/mention (true / false)
RESPOND_GROUP_TAG_ONLY=true

# Nomor HP Pemilik / Admin Toko (opsional, format 628xxxxxxxx)
OWNER_NUMBER=
